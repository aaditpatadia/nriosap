# Copy to .env.local for a real deployment. For local testing without any accounts, see README ("Local stack").

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the transaction pooler string (port 6543) on Vercel.
DATABASE_URL=
# Base64 of the Supabase CA certificate. Without it the connection is encrypted but the server is not verified.
DATABASE_CA_CERT=
# 1 on Vercel so each function holds a single connection.
PG_POOL_MAX=1

# Public address of the app, no trailing slash. Used for sign-in links.
APP_URL=
# 32 or more random bytes. Encrypts policy numbers and extracted fields. Losing it loses that data.
APP_ENCRYPTION_KEY=

# Demo family. Leave off in production.
DEMO_MODE=0
SEED_STAFF_PASSWORD=
DEMO_OWNER_EMAIL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SENTRY_DSN=
