# Copy to .env.local for a real deployment. For local testing with no accounts, see README ("Local stack").

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for Storage and creating accounts.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase connection string. On Vercel use the transaction pooler (port 6543).
DATABASE_URL=
# Base64 of the Supabase CA certificate. Set this in production: without it the connection is encrypted but the server is not verified.
DATABASE_CA_CERT=
# 1 on Vercel so each function holds a single connection.
PG_POOL_MAX=1
# Public address, no trailing slash. Used for sign-in links and Stripe return links.
APP_URL=
# 32 or more random bytes. Encrypts policy numbers and extracted fields. Losing it loses that data.
APP_ENCRYPTION_KEY=

# 1 shows "Continue with Google". Turn the Google provider on in Supabase first.
GOOGLE_SIGNIN=0

# --- Document reading ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
EXTRACTOR_MODEL=
# Set to "mock" to run without an API key.
EXTRACTOR=
# POST of raw bytes returning {"verdict":"clean"|"infected"}. Without it only the EICAR test file is caught.
VIRUS_SCAN_URL=

# --- WhatsApp Cloud API. Setup steps: NOTES.md, "WhatsApp setup" ---
# Webhook URL for Meta: https://YOUR-DOMAIN/api/whatsapp/webhook
# A long random string you make up. Paste the same one into the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app settings, Basic, App secret. Signs every webhook body. Secret: never commit or print it.
WHATSAPP_APP_SECRET=
# A permanent System User token with whatsapp_business_messaging and whatsapp_business_management. Secret.
WHATSAPP_ACCESS_TOKEN=
# The phone number's ID from WhatsApp Manager (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# The switch for all outbound WhatsApp. Keep 0 until business verification and template approval are done.
# While 0, replies wait in the ops outbox as "would send". Go-live checks fail if this is 1 and any setting above is empty.
WHATSAPP_SENDING=0
# Older name for the same switch. Either one at 1 turns sending on.
WHATSAPP_SEND_ENABLED=0
# Optional. Model for reading WhatsApp texts. Defaults to EXTRACTOR_MODEL, then claude-opus-5-5.
WHATSAPP_CATEGORISER_MODEL=
# Optional limits per minute. Over the per-number limit a message is kept but not read automatically.
# Over the global limit the webhook answers 503 and Meta delivers again later.
WHATSAPP_LIMIT_PER_NUMBER=20
WHATSAPP_LIMIT_GLOBAL=600
# Number shown on "Talk to a person" for visitors who are not signed in, digits only.
NEXT_PUBLIC_DESK_WHATSAPP=
# Optional. A public support address the assistant offers as "Email us". Leave empty to show WhatsApp only.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Voice notes ---
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4

# --- Stripe. Test mode only: keys that do not start with sk_test_ are refused ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_40=
STRIPE_PRICE_79=
STRIPE_PRICE_119=

# --- Operations ---
# Repeated failed sign-ins always show on the ops page. With this set, Sentry can email you too.
SENTRY_DSN=
# Required on Vercel. Without it the job endpoint stays shut and no scheduled job runs.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Demo family. Leave off in production ---
DEMO_MODE=0
SEED_STAFF_PASSWORD=
DEMO_OWNER_EMAIL=
