{
  "name": "ally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js -c tools/lint/eslint.config.mjs .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "local:stack": "node scripts/local/stack.mjs",
    "local:build": "node scripts/local/with-env.mjs next build",
    "local:dev": "node scripts/local/with-env.mjs next dev -p 3100",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "user:create": "node --env-file=.env.local scripts/create-user.mjs",
    "lint:setup": "npm --prefix tools/lint install",
    "go-live": "node scripts/go-live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@sentry/nextjs": "^11.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "inngest": "^4.26.2",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^17.5.0-beta.15",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "inngest": {
      "zod": "$zod"
    },
    "rimraf": "^6.1.4",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
