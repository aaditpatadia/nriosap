{
  "name": "gharsaath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "local:stack": "node scripts/local/stack.mjs",
    "local:build": "node scripts/local/with-env.mjs next build",
    "local:dev": "node scripts/local/with-env.mjs next dev -p 3100",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "user:create": "node --env-file=.env.local scripts/create-user.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
